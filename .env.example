# Copie para .env.local e preencha com os valores de `npx supabase start`
# (local) ou do painel do seu projeto (produção).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_BACKEND_PROVIDER=supabase

# Server-only — nunca prefixe com NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3000

# Billing: "fake" simula o ciclo completo em dev; "stripe" exige as chaves.
PAYMENT_GATEWAY=fake
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Price IDs criados no Stripe (test ou live) — sem eles o checkout real falha:
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_ENTERPRISE=
# STRIPE_PRICE_EXTRA_SEAT=

# Email: "console" imprime no terminal em dev; "resend" exige as chaves.
EMAIL_PROVIDER=console
# RESEND_API_KEY=
# EMAIL_FROM=no-reply@seudominio.com

# Notificações externas (WhatsApp/SMS/push): só "console" implementado por
# enquanto (imprime no terminal). Adapters novos: src/adapters/notification.
NOTIFICATION_PROVIDER=console

# Rate limit: "memory" (default) vale só por instância — em produção
# multi-instância/serverless use "redis" com Upstash (Console > REST API).
RATE_LIMIT_STORE=memory
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# Domínio próprio das igrejas: "fake" percorre o fluxo inteiro sem rede nem
# conta na Vercel; "vercel" exige token com acesso ao projeto.
DOMAIN_PROVIDER=fake
# VERCEL_API_TOKEN=
# VERCEL_PROJECT_ID=prj_xxx
# VERCEL_TEAM_ID=team_xxx           # só se o projeto for de um time
# Valores de DNS anunciados às igrejas. Só preencha para sobrescrever os
# defaults do adapter (76.76.21.21 / cname.vercel-dns.com) se a Vercel mudar.
# VERCEL_DNS_A_RECORD=
# VERCEL_DNS_CNAME=
# Segredo do Vercel Cron (Settings > Environment Variables). Sem ele os jobs
# (verificação de domínio e sincronização de patrocínio) respondem 404.
# CRON_SECRET=

# Patrocínio (cobrança recorrente de valor variável). "fake" cobra na hora,
# sem rede — dá para percorrer o fluxo inteiro em dev. Contas já existentes
# seguem no provedor gravado nelas; esta variável vale para as NOVAS.
SPONSOR_BILLING_PROVIDER=fake
# ASAAS_API_KEY=
# ASAAS_API_URL=https://api-sandbox.asaas.com/v3   # produção: https://api.asaas.com/v3
# Token que o painel do Asaas envia no header asaas-access-token (mín. 16 caracteres).
# Webhook: https://seu-dominio.com/api/webhooks/sponsor-billing/asaas
# ASAAS_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# Recebimento da igreja (doação por cartão na subconta dela)
# ---------------------------------------------------------------------------
# Opcional para a igreja: quem só quer PIX não precisa de nada disto. Quando
# ligado, a plataforma abre uma subconta NO NOME DA IGREJA e é lá que o
# dinheiro do cartão cai — sem passar pela conta da plataforma e sem taxa
# nossa. "fake" aprova na hora e não toca a rede.
RECEIVING_PROVIDER=fake
# Usa a mesma ASAAS_API_KEY acima (a chave da conta-MÃE abre as subcontas).
# Webhook das doações: https://seu-dominio.com/api/webhooks/donations/asaas
# (cada igreja tem o seu token, criado junto com a subconta).
#
# Chave de 32 bytes que cifra a chave de API de cada subconta antes de ela ir
# ao banco. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PERDER esta chave = perder o acesso às subcontas já criadas.
RECEIVING_KEY_SECRET=
