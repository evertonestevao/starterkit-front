# Copie para .env.local e preencha com os valores de `npx supabase start`
# (local) ou do painel do seu projeto (produção).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_BACKEND_PROVIDER=supabase

# Server-only — nunca prefixe com NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3000

# Billing: "fake" simula o ciclo completo em dev; "stripe" exige as chaves.
PAYMENT_GATEWAY=fake
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Email: "console" imprime no terminal em dev; "resend" exige as chaves.
EMAIL_PROVIDER=console
# RESEND_API_KEY=
# EMAIL_FROM=no-reply@seudominio.com
