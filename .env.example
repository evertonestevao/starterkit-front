# Copie para .env.local e preencha com os valores de `npx supabase start`
# (local) ou do painel do seu projeto (produção).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_BACKEND_PROVIDER=supabase

# Server-only — nunca prefixe com NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3000

# Billing: "fake" simula o ciclo completo em dev; "asaas" e "stripe" exigem as chaves.
PAYMENT_GATEWAY=fake

# Asaas (cobra pelo valor do plano no banco — não precisa de PAYMENT_PRICE_*):
# ASAAS_API_KEY=$aact_...
# ASAAS_WEBHOOK_TOKEN=          # o mesmo token cadastrado no webhook do painel Asaas
# ASAAS_ENVIRONMENT=sandbox     # sandbox | production

# Stripe:
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Ids de preço do catálogo do gateway (só Stripe usa). STRIPE_PRICE_* também é aceito:
# PAYMENT_PRICE_PRO=
# PAYMENT_PRICE_ENTERPRISE=
# PAYMENT_PRICE_EXTRA_SEAT=

# Email: "console" imprime no terminal em dev; "resend" exige as chaves.
EMAIL_PROVIDER=console
# RESEND_API_KEY=
# EMAIL_FROM=no-reply@seudominio.com

# Notificações externas (WhatsApp/SMS/push): só "console" implementado por
# enquanto (imprime no terminal). Adapters novos: src/adapters/notification.
NOTIFICATION_PROVIDER=console

# Rate limit: "memory" (default) vale só por instância — em produção
# multi-instância/serverless use "redis" com Upstash (Console > REST API).
RATE_LIMIT_STORE=memory
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# Monitoramento de erros: console (só log do servidor) ou sentry (API HTTP, sem SDK).
ERROR_REPORTER=console
# SENTRY_DSN=https://<chave>@<host>/<projeto>
# Nome do ambiente nos relatórios de erro.
APP_ENV=development
